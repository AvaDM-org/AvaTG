{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AvaTG",
  "version": "0.1.0",
  "identifier": "org.avadm.avatg",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AvaTG",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 560,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFGMTU1NDc3QjgxMUNBMTgKUldRWXloRzRkMVFWSDRkZGJGVDdyUjZ1ZUl1Z0t1aU84MklXY01tNXdzQjZyYUNQRmVHaTNHTjkK",
      "endpoints": [
        "https://github.com/AvaDM-org/AvaTG/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
